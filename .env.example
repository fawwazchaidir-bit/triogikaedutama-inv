# ─────────────────────────────────────────────────────────────
# Trilogika Edutama — Invoice Management System
# Salin file ini menjadi `.env` lalu isi nilainya. JANGAN commit `.env`.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string (wajib)
DATABASE_URL="postgresql://trilogika:CHANGE_ME@localhost:5432/trilogika_invoice?schema=public"

# URL publik aplikasi. Dipakai untuk pemeriksaan Origin (CSRF) dan penentuan cookie `Secure`.
# Production wajib https://
APP_URL="http://localhost:3000"

# Zona waktu bisnis (untuk "hari ini", jatuh tempo, overdue, dan pelaporan bulanan)
APP_TIMEZONE="Asia/Jakarta"

# Set "true" HANYA jika aplikasi berada di belakang reverse proxy tepercaya (Nginx/Caddy/Cloudflare)
# sehingga header X-Forwarded-For boleh dipercaya untuk rate limit login.
TRUST_PROXY="false"

# Autentikasi dua langkah (TOTP). DATA_ENCRYPTION_KEY mengenkripsi rahasia TOTP di database: openssl rand -hex 32
# (jangan diganti setelah ada pengguna ber-2FA; simpan terpisah dari backup database).
# MFA_REQUIRED_ROLES = peran yang WAJIB 2FA (mis. "ADMIN,FINANCE"); pengguna itu diminta mengaktifkan saat masuk. Kosong = opsional.
DATA_ENCRYPTION_KEY=""
MFA_REQUIRED_ROLES=""

# Integrasi mesin-ke-mesin (website, Portal). Kosong = fitur nonaktif. Buat dengan: openssl rand -hex 32
# JANGAN diganti setelah kredensial dibuat (semua rahasia turunan akan berubah → semua kredensial harus dirotasi).
INTEGRATION_MASTER_KEY=""

# Pembatasan percobaan login (per email dan per IP)
LOGIN_MAX_ATTEMPTS="5"
LOGIN_WINDOW_MINUTES="15"
LOGIN_LOCKOUT_MINUTES="15"

# Masa berlaku sesi
SESSION_IDLE_HOURS="8"
SESSION_ABSOLUTE_DAYS="7"

# Batas unggahan (logo, tanda tangan, bukti pembayaran) dalam MB
MAX_UPLOAD_MB="3"

# ── Seed produksi (`npm run db:seed`) ─────────────────────────
# Akun Administrator pertama. Tidak ada password default: seed GAGAL bila kosong / terlalu lemah (<12 karakter).
ADMIN_EMAIL=""
ADMIN_NAME="Administrator"
ADMIN_PASSWORD=""

# ── Seed development (`npm run db:seed:dev`) ──────────────────
# Password untuk akun demo (admin/finance/staff). Bila kosong, dibuat acak dan dicetak sekali di terminal.
DEV_SEED_PASSWORD=""

# ── Testing ───────────────────────────────────────────────────
# Database TERPISAH untuk integration/E2E test. Tabel di dalamnya akan dikosongkan oleh test!
TEST_DATABASE_URL="postgresql://trilogika:CHANGE_ME@localhost:5432/trilogika_test?schema=public"
